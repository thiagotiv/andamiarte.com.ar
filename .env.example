# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
MONGODB_DB_NAME="andamiarte"

# JWT Secret for Session & Auth Token Generation (minimum 32 characters)
JWT_SECRET="your-jwt-secret-key-here"
GOOGLE_CLIENT_ID="<tu_id_de_cliente_google>"
VITE_GOOGLE_CLIENT_ID="<tu_id_de_cliente_google>"
GOOGLE_CLIENT_SECRET="<tu_secreto_de_cliente_google>"

# Cloudinary (Almacenamiento multimedia para publicaciones: fotos, videos, PDFs)
VITE_CLOUDINARY_CLOUD_NAME="<tu_cloud_name>"
VITE_CLOUDINARY_UPLOAD_PRESET="<tu_upload_preset>"
